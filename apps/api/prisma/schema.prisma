generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  SOLD
  LOST
  RENEWAL_DUE
  MISSING_INFO
}

enum InsuranceType {
  TRAFFIC
  KASKO
  MOTORCYCLE
  DASK
  HOME_CONTENT
  HEALTH
  BUSINESS
  FIRE
  TRAVEL
}

model Lead {
  id                         String        @id @default(uuid())
  tracking_id                String        @unique
  insurance_category         String
  insurance_type             InsuranceType
  dynamic_fields             Json
  phone                      String        @unique
  utm_source                 String?
  utm_campaign               String?
  lead_source                String?
  status                     LeadStatus    @default(NEW)
  birth_date                 DateTime?
  existing_policy_expires_at DateTime?
  created_at                 DateTime      @default(now())
  updated_at                 DateTime      @updatedAt

  @@map("leads")
}
